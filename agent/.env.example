# Copy this file to .env (same folder) and fill in your key.
# .env is read by src/llm_client.py; it is NOT committed/printed anywhere.

# Default provider is OpenRouter (OpenAI-style chat completions API), so you can point
# CATALIST_MODEL at whatever underlying model you want later, e.g.:
#   anthropic/claude-sonnet-4.5
#   openai/gpt-4o-mini
#   google/gemini-2.5-flash
OPENROUTER_API_KEY=sk-or-your-key-here
# CATALIST_MODEL=anthropic/claude-sonnet-4.5

# To call Anthropic directly instead, set LLM_PROVIDER=anthropic and use:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# CATALIST_MODEL=claude-sonnet-4-5

# To call Gemini directly instead (e.g. a Google AI Studio key), set LLM_PROVIDER=gemini and use:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza-your-key-here
# CATALIST_MODEL=gemini-2.5-flash

# To use Groq instead (genuinely free tier, no prepaid billing), set LLM_PROVIDER=groq and use:
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_your-key-here
# CATALIST_MODEL=openai/gpt-oss-120b
# Optional second Groq key (separate free account = its own independent 8000 TPM quota),
# used by src/parallel_ledger.py to split remaining work across two independent budgets:
# GROQ_API_KEY_2=gsk_your-second-key-here
